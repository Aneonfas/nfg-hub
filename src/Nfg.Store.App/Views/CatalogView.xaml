<UserControl x:Class="Nfg.Store.App.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1200">
    <UserControl.Resources>
        <Style x:Key="CatalogCardButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="354" />
            <Setter Property="Height" Value="294" />
            <Setter Property="Margin" Value="0,0,18,18" />
            <Setter Property="Padding" Value="24,22" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="{StaticResource SurfaceRaisedBrush}" />
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="#556234" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentDarkBrush}" />
                                <Setter TargetName="CardBorder"
                                        Property="BorderThickness"
                                        Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#20251F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInLibrary}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AccentDarkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCatalogVersionUnverified}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AmberBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasNewerCatalogVersion}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AmberBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUpdateInProgress}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AmberBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CatalogStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInLibrary}" Value="True">
                    <Setter Property="Foreground" Value="#B9C98A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCatalogVersionUnverified}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasNewerCatalogVersion}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUpdateInProgress}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="CatalogScrollViewer"
                  Background="{StaticResource BackgroundBrush}"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly"
                  VerticalScrollBarVisibility="Auto"
                  Loaded="CatalogScrollViewer_OnLoaded"
                  Unloaded="CatalogScrollViewer_OnUnloaded"
                  ScrollChanged="CatalogScrollViewer_OnScrollChanged">
        <Grid Margin="32,20,32,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Каталог"
                           Style="{StaticResource PageTitleStyle}" />
            </StackPanel>

            <ItemsControl Grid.Row="1"
                          Margin="0,28,-18,0"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding Products}"
                          Visibility="{Binding HasProducts, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CatalogCardButtonStyle}"
                                Command="{Binding DataContext.OpenProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Product.Title}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border HorizontalAlignment="Left"
                                        Padding="8,4"
                                        Background="#20251F"
                                        BorderBrush="#3D482B"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <TextBlock Text="{Binding Product.TypeLabel, FallbackValue=ПРОДУКТ, TargetNullValue=ПРОДУКТ}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Border>

                                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                    <TextBlock Text="{Binding Product.Title}"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="23"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding Product.Subtitle}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Row="2"
                                           Height="58"
                                           Margin="0,13,0,0"
                                           VerticalAlignment="Top"
                                           Text="{Binding Product.Summary}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           LineHeight="19"
                                           Foreground="#B9BFC8" />

                                <Grid Grid.Row="3"
                                      Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="8,5"
                                            Background="#111419"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="v "
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding CatalogVersionLabel}"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="11"
                                                       Foreground="#D7DCE2" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Padding="8,5"
                                            Background="#111419"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <TextBlock Text="{Binding CatalogCompatibilityLabel}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="11"
                                                   Foreground="#D7DCE2" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="4" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7"
                                             Height="7"
                                             Margin="0,1,9,0"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource CatalogStatusDotStyle}" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Text="{Binding CatalogStatusText, FallbackValue=Доступно}"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource CatalogStatusTextStyle}" />
                                    <TextBlock Grid.Column="2"
                                               Margin="12,0,0,0"
                                               Text="→"
                                               FontSize="17"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="1"
                    Margin="0,72,0,0"
                    Padding="42,38"
                    MaxWidth="620"
                    HorizontalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Border Width="64"
                            Height="64"
                            HorizontalAlignment="Center"
                            Background="#20251F"
                            BorderBrush="#3D482B"
                            BorderThickness="1"
                            CornerRadius="18">
                        <TextBlock Text="▦"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="29"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Margin="0,20,0,0"
                               HorizontalAlignment="Center"
                               Text="Каталог пока пуст"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,9,0,0"
                               Text="Продукты появятся здесь после обновления каталога."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
