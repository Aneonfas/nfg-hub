<UserControl x:Class="Nfg.Store.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1200">
    <Grid Background="{StaticResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      Visibility="{Binding HasProducts, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="44,34,44,48"
                        HorizontalAlignment="Stretch">
                <TextBlock Text="Библиотека"
                           Style="{StaticResource PageTitleStyle}" />

                <ItemsControl Margin="0,30,0,0"
                              ItemsSource="{Binding Products}"
                              HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,18"
                                    Padding="28,25"
                                    MinHeight="250"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="360" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Padding="9,4"
                                                    Background="#20251F"
                                                    BorderBrush="#3A432F"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <TextBlock Text="В БИБЛИОТЕКЕ"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                            <Border Margin="8,0,0,0"
                                                    Padding="9,4"
                                                    Background="#1B1F25"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <TextBlock Text="{Binding LocalCompatibilityLabel}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelectedVersionUnverified}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Margin="0,16,0,0"
                                                   Text="{Binding Product.Title}"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="27"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="{Binding Product.Subtitle}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Margin="0,13,0,0"
                                                   MaxWidth="650"
                                                   HorizontalAlignment="Left"
                                                   Text="{Binding Product.Summary}"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"
                                                   LineHeight="22"
                                                   Foreground="#C1C6CE" />

                                        <StackPanel Margin="0,19,0,0"
                                                    Orientation="Horizontal">
                                            <Button MinWidth="148"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="Описание продукта"
                                                    Command="{Binding DataContext.OpenProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <StackPanel Margin="18,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Установлена "
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding InstalledVersionLabel}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               Foreground="#D7DCE2" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsNotInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="В каталоге "
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding SelectedVersionLabel}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               Foreground="#D7DCE2" />
                                                </StackPanel>
                                                <TextBlock Margin="14,0,0,0"
                                                           Text="{Binding UpdateVersionText}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource AmberBrush}"
                                                           Visibility="{Binding HasRecommendedVersionChange, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Margin="0,21,0,0"
                                              Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ProgressBar Height="6"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding OperationProgress, Mode=OneWay}" />
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,9,0,0"
                                                       Text="{Binding OperationStatus}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Grid>

                                        <TextBlock Margin="0,15,0,0"
                                                   Text="{Binding OperationStatus}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OperationStatus}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsProgressVisible}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Width="1"
                                            Margin="13,0"
                                            HorizontalAlignment="Center"
                                            Background="{StaticResource BorderBrush}" />

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">
                                        <StackPanel Margin="0,0,0,20"
                                                    Visibility="{Binding HasMultipleVersions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Margin="1,0,0,7"
                                                       Text="ВЕРСИЯ ДЛЯ УСТАНОВКИ"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <ComboBox ItemsSource="{Binding AvailableVersions}"
                                                      SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanSelectVersion}"
                                                      AutomationProperties.Name="Выбор версии продукта"
                                                      Style="{StaticResource VersionComboBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button Margin="0,0,0,20"
                                                    HorizontalAlignment="Stretch"
                                                    Content="{Binding UpdateActionText}"
                                                    Command="{Binding UpdateCommand}"
                                                    IsEnabled="{Binding CanUpdate}">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource PrimaryButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSelectedVersionChange}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsUpdateInProgress}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock Text="УСТАНОВЛЕН НА УСТРОЙСТВЕ"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <StackPanel Margin="0,10,0,0"
                                                        Orientation="Horizontal">
                                                <TextBlock Margin="0,0,12,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding ActivationStatusText}"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProductEnabled}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                                          IsChecked="{Binding IsProductEnabled, Mode=OneWay}"
                                                          Command="{Binding ToggleProductCommand}"
                                                          IsEnabled="{Binding CanToggleProduct}"
                                                          AutomationProperties.Name="{Binding ToggleAutomationName}" />
                                            </StackPanel>
                                            <Button Margin="0,18,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="Удалить с устройства"
                                                    Command="{Binding RemoveFromDeviceCommand}"
                                                    IsEnabled="{Binding CanRemoveFromDevice}" />
                                        </StackPanel>

                                        <Button Margin="0,0,0,0"
                                                HorizontalAlignment="Stretch"
                                                Content="{Binding PrimaryActionText}"
                                                Command="{Binding InstallCommand}"
                                                IsEnabled="{Binding CanInstall}">
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource PrimaryButtonStyle}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Border Height="1"
                                                Margin="0,24,0,20"
                                                Background="{StaticResource BorderBrush}" />

                                        <Button HorizontalAlignment="Stretch"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Удалить из библиотеки"
                                                Command="{Binding RemoveFromLibraryCommand}"
                                                IsEnabled="{Binding CanRemoveFromLibrary}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Width="540"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="72"
                    Height="72"
                    HorizontalAlignment="Center"
                    Background="#1B201B"
                    BorderBrush="#39422E"
                    BorderThickness="1"
                    CornerRadius="20">
                <TextBlock Text="▤"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="31"
                           Foreground="{StaticResource AccentBrush}" />
            </Border>
            <TextBlock Margin="0,22,0,0"
                       Text="Библиотека пока пуста"
                       HorizontalAlignment="Center"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Margin="0,10,0,0"
                       Text="Выберите продукт в каталоге и нажмите «Установить» — он появится здесь сразу после начала операции."
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="15"
                       LineHeight="23"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
