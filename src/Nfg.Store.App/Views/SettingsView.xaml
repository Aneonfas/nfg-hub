<UserControl x:Class="Nfg.Store.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{StaticResource BackgroundBrush}">
        <StackPanel Margin="36,26,36,44" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Настройки" Style="{StaticResource PageTitleStyle}" />

            <Border Margin="0,26,0,0"
                    Padding="24,20"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Автоматическая проверка обновлений"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="Проверять каталог при запуске приложения."
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding SettingsSaveError}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource DangerBrush}"
                                   Visibility="{Binding HasSettingsSaveError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Margin="24,0,0,0"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding CheckUpdatesAutomatically}"
                              VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="24,20"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Источник каталога"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,7,0,0"
                               Text="{Binding CatalogSource}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="13"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding CatalogSourceDescription}"
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="24,20"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Данные приложения"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,7,0,0"
                               Text="{Binding DataPath}"
                               TextWrapping="Wrap"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="13"
                               Foreground="#C7CDD5" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Здесь будут храниться состояние установок, staging-загрузки и записи для отката."
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
