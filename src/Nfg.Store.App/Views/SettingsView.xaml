<UserControl x:Class="Nfg.Store.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nfg.Store.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{StaticResource BackgroundBrush}">
        <StackPanel Margin="36,26,36,44" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Loc Nav.Settings}" Style="{StaticResource PageTitleStyle}" />

            <Border Margin="0,26,0,0"
                    Padding="24,20"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Settings.Language}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,24,0"
                                   Text="{loc:Loc Settings.Language.Description}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              Style="{StaticResource VersionComboBoxStyle}"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NativeName}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="24,20"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings.Updates}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="{loc:Loc Settings.Updates.Description}"
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding SettingsSaveError}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource DangerBrush}"
                                   Visibility="{Binding HasSettingsSaveError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Margin="24,0,0,0"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding CheckUpdatesAutomatically}"
                              VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="24,20"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings.CatalogSource}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,7,0,0"
                               Text="{Binding CatalogSource}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="13"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding CatalogSourceDescription}"
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="24,20"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings.AppData}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,7,0,0"
                               Text="{Binding DataPath}"
                               TextWrapping="Wrap"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="13"
                               Foreground="#C7CDD5" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{loc:Loc Settings.AppData.Description}"
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
